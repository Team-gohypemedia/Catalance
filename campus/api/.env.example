# Catalance Campus API: copy to .env and fill in.
#
# Campus shares the EXISTING Catalance Neon database, fully isolated in its own Postgres schema "campus".
# Use the SAME connection strings as the main backend (backend/.env):
#   CAMPUS_DATABASE_URL = backend DATABASE_URL         (pooled)
#   CAMPUS_DIRECT_URL   = backend DIRECT_DATABASE_URL  (direct, used by prisma db push / migrate)
# You don't need to add ?schema=campus: prisma/schema.prisma pins every model and enum to the "campus" schema
# (schemas = ["campus"] + @@schema("campus")), so Campus never reads or writes the main app's "public" tables.
CAMPUS_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require"
CAMPUS_DIRECT_URL="postgresql://user:password@ep-xxxx.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# Campus uses Catalance accounts: it accepts the access tokens the main backend issues.
# Must be the SAME value as JWT_SECRET in backend/.env (and in the main backend's Vercel env).
CATALANCE_JWT_SECRET="same-as-backend-JWT_SECRET"

# Comma-separated list of allowed web origins
CAMPUS_CORS_ORIGIN="http://localhost:5180"

PORT=5100

# AI tutor (OpenRouter). Without a key the tutor returns a friendly fallback reply.
CAMPUS_OPENROUTER_API_KEY=""
CAMPUS_AI_MODEL="openai/gpt-4o-mini"

# Course payments (Razorpay hosted checkout; Campus never sees card details). Leave empty to offer offline payment only.
# Webhook URL: <api>/api/webhooks/razorpay, events payment.captured, payment.failed, refund.processed.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email notifications (spec §12) via Resend (https://resend.com), the same provider as the main Catalance backend.
# Leave RESEND_API_KEY empty to skip emails (they are logged instead). The From domain must be verified in Resend.
RESEND_API_KEY=""
CAMPUS_EMAIL_FROM="Catalance Campus <campus@catalance.in>"
# Public web URL used for links inside emails (defaults to the first CAMPUS_CORS_ORIGIN)
CAMPUS_WEB_URL="http://localhost:5180"

# Assessment file uploads (spec §15): a PRIVATE Cloudflare R2 bucket (S3 API). Students upload with a presigned PUT
# (10 min) and every read is a presigned GET (10 min); no public URL is ever stored. Leave empty to turn uploads off
# (the API answers 503 and the web hides the upload control; links and text still work).
# The bucket needs a CORS rule allowing PUT/GET from CAMPUS_CORS_ORIGIN with the Content-Type header (see docs/OPERATIONS.md).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Scheduler (spec §12 reminders, offer expiry): POST or GET /api/cron/tick with "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends exactly that header when CRON_SECRET is set in the project env. Empty = the endpoint answers 503.
# Locally: npm run cron:tick (no HTTP, no secret needed).
CRON_SECRET=""
