# Leave empty to run in demo mode (data lives in the browser, no backend needed).
# Set to the Campus API URL to use the real backend, e.g. http://localhost:5100
VITE_CAMPUS_API_URL=

# Main Catalance app, where people sign in (Campus uses Catalance accounts). Unused in demo mode.
# Defaults: http://localhost:5173 in dev, https://catalance.in in production builds.
VITE_CATALANCE_URL=
